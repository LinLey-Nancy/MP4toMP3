@echo off
chcp 65001 >nul
setlocal
cd /d "%~dp0"
title MP4toMP3 - transcribe build (mini + full)

REM ==========================================================================
REM  Dual release build for the transcribe edition:
REM    - onedir layout, ffmpeg.exe bundled via --add-binary
REM    - MP4toMP3-mini.zip : app only, models download on first transcribe
REM    - MP4toMP3-full.zip : app + models\ (offline ready), sha256 manifest
REM                          generated by tools\build_manifest.py before copy
REM  CPU baseline only; CUDA accel (cuBLAS/cuDNN) is a phase-2 option.
REM ==========================================================================

set "PY=.venv\Scripts\python.exe"
set "APP=MP4toMP3"
set "APPDIR=dist\%APP%"
set "MINI_ZIP=dist\%APP%-mini.zip"
set "FULL_ZIP=dist\%APP%-full.zip"

echo ==========================================
echo   MP4toMP3 transcribe build (mini + full)
echo ==========================================
echo.

REM ---- 0. sanity checks ----
if not exist "%PY%" (
    echo [ERROR] %PY% not found. Create the venv and install requirements-transcribe.txt first.
    pause
    exit /b 1
)
if not exist "main.py" (
    echo [ERROR] main.py not found. Run this script from the project root.
    pause
    exit /b 1
)
if not exist "ffmpeg.exe" (
    echo [ERROR] ffmpeg.exe not found. Put it next to main.py.
    pause
    exit /b 1
)
if not exist "models" (
    echo [ERROR] models\ not found; the full package needs the model directory.
    pause
    exit /b 1
)

REM ---- 1. clean previous build artifacts ----
echo [1/5] Cleaning old build artifacts...
if exist "build" rmdir /s /q "build"
if exist "%APPDIR%" rmdir /s /q "%APPDIR%"
if exist "%MINI_ZIP%" del /q "%MINI_ZIP%"
if exist "%FULL_ZIP%" del /q "%FULL_ZIP%"
if exist "%APP%.spec" del /q "%APP%.spec"

REM ---- 2. PyInstaller onedir build ----
REM sherpa_onnx / ctranslate2 have no hooks in pyinstaller-hooks-contrib:
REM their native DLLs (sherpa_onnx\lib\*.dll, ctranslate2.dll, libiomp5md.dll)
REM are not picked up by import analysis, so collect the whole packages.
REM numpy 2.x: numpy._core._exceptions is imported lazily and missed by PYZ
REM analysis -> transcribe fails with ModuleNotFoundError in the frozen app.
REM faster_whisper: package data assets\silero_vad_v6.onnx (VAD model) is not
REM collected by default -> vad_filter=True crashes in the frozen app.
echo [2/5] PyInstaller onedir build (this takes a few minutes)...
"%PY%" -m PyInstaller --noconfirm --clean --onedir --windowed ^
    --name "%APP%" ^
    --add-binary "ffmpeg.exe;." ^
    --collect-all sherpa_onnx ^
    --collect-all ctranslate2 ^
    --collect-data faster_whisper ^
    --hidden-import numpy._core._exceptions ^
    main.py
if errorlevel 1 (
    echo.
    echo [ERROR] PyInstaller build failed. See the log above.
    pause
    exit /b 1
)

REM ---- 3. mini package: zip the app dir as-is (no models) ----
echo [3/5] Packing %MINI_ZIP% (no models)...
powershell -NoProfile -Command "Compress-Archive -Path '%APPDIR%' -DestinationPath '%MINI_ZIP%' -Force"
if errorlevel 1 (
    echo [ERROR] Failed to create %MINI_ZIP%
    pause
    exit /b 1
)

REM ---- 4. sha256 manifest, then copy models into the app dir ----
echo [4/5] Generating models manifest and copying models\ into %APPDIR%...
"%PY%" tools\build_manifest.py models
if errorlevel 1 (
    echo [ERROR] tools\build_manifest.py failed
    pause
    exit /b 1
)
robocopy "models" "%APPDIR%\models" /E /NFL /NDL /NJH /NJS >nul
if errorlevel 8 (
    echo [ERROR] Failed to copy models\ into %APPDIR%
    pause
    exit /b 1
)

REM ---- 5. full package: zip the app dir with models ----
echo [5/5] Packing %FULL_ZIP% (models included, this takes a while)...
powershell -NoProfile -Command "Compress-Archive -Path '%APPDIR%' -DestinationPath '%FULL_ZIP%' -Force"
if errorlevel 1 (
    echo [ERROR] Failed to create %FULL_ZIP%
    pause
    exit /b 1
)

REM Note: %APPDIR% keeps the models\ copy after the build (full layout,
REM ready to run offline). Step 1 wipes it on the next run, so rebuilds
REM stay idempotent.

echo.
echo ==========================================
echo   Build OK:
echo     %MINI_ZIP%  (models download on first run)
echo     %FULL_ZIP%  (offline ready, models included)
echo ==========================================
explorer "dist"
pause
